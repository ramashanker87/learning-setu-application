# Compose supplies safe synthetic defaults. Never use this authentication in AWS.
LOCAL_AUTH_SECRET=synthetic-local-only-secret-never-use-in-production
# AWS CLI scripts default to these; production credentials come from your profile.
AWS_PROFILE=jso
AWS_REGION=ap-south-1

# Cognito-managed organization activation invitations (independent of SMTP/transcription).
ENABLE_ACTIVATION_EMAILS=false
