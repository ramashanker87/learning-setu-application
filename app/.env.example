# GoLand / host-run configuration; set working directory to app/.
APP_ENV=local
AUTH_MODE=local
TRANSCRIPTION_PROVIDER=mock
WORKER_MODE=all
LOCAL_AUTH_SECRET=synthetic-local-only-secret-never-use-in-production
AWS_REGION=ap-south-1
CONTROL_TABLE=setu-control-local
DOCUMENT_BUCKET=setu-documents-local
RESOURCE_PREFIX=setu-local
DYNAMODB_ENDPOINT=http://localhost:8100
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
APP_ORIGIN=http://localhost:8080
FRONTEND_DIR=../frontend
SMTP_HOST=localhost
SMTP_PORT=1025
PORT=3000
# Production only: Cognito variables, SARVAM_API_KEY, SMTP credentials from Secrets Manager.
